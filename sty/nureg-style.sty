% =====================================================================
% nureg-style.sty
% Estilo visual inspirado nos documentos regulatorios do NRC:
%   - NUREG-1537 (Format and Content / Standard Review Plan) - USNRC
%   - AP1000 Design Control Document (DCD), Tier 2 - Westinghouse/NRC
%
% Este pacote NAO reproduz nenhum brasao ou selo oficial do governo dos
% EUA; apenas imita convencoes tipograficas publicas (numeracao de
% pagina por capitulo, cabecalhos/rodapes com titulo de secao e
% revisao, tabelas em grade) amplamente usadas por requerentes de
% licenciamento nuclear em todo o mundo ao redigir seus proprios SAR/FSAR.
% =====================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nureg-style}[2026/09/10 NUREG/AP1000-style report style]

% ---------------------------------------------------------------------
% Fontes: familia Times-like, proxima da usada em NUREG/DCD impressos
% ---------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{mathptmx}
\RequirePackage{helvet}
\RequirePackage{microtype}

% Espacamento de linha ligeiramente maior que o padrao (leitura mais
% confortavel em texto corrido longo, estilo relatorio) + fonte em
% 12pt (definida via opcao da classe em main.tex)
\RequirePackage{setspace}
\setstretch{1.32}

% ---------------------------------------------------------------------
% Idioma / hifenizacao (documento em portugues)
% ---------------------------------------------------------------------
\RequirePackage[brazil]{babel}

% ---------------------------------------------------------------------
% Layout de pagina - margens tipicas de SAR/DCD (encadernacao em
% fichario de 3 furos, folha carta)
% ---------------------------------------------------------------------
\RequirePackage[letterpaper,top=2.4cm,bottom=2.5cm,left=3.0cm,right=2.3cm,headheight=14pt,headsep=10pt,footskip=30pt]{geometry}

% ---------------------------------------------------------------------
% Numeracao de pagina por capitulo: "1-1", "1-2", ... "2-1", ...
% (identica a convencao usada na propria NUREG-1537 e em FSAR/DCD)
% ---------------------------------------------------------------------
\RequirePackage{chappg}
% chappg intercepta \mainmatter automaticamente (opcao "auto", padrao)
% e redefine \thepage para "<capitulo>-<pagina>", ex.: 1-1, 1-2, 2-1 ...

% ---------------------------------------------------------------------
% Cores institucionais neutras (nao usa o azul/dourado do selo NRC;
% paleta neutra de "documento tecnico regulatorio")
% ---------------------------------------------------------------------
\RequirePackage{xcolor}
\RequirePackage{colortbl}
\definecolor{nurule}{RGB}{20,30,45}
\definecolor{nugray}{RGB}{90,90,90}
\definecolor{nutablehead}{RGB}{225,230,236}

% ---------------------------------------------------------------------
% Cabecalho / rodape no formato exigido pelo Cliente (CNEN). Versao
% enxuta (revisada a pedido do requerente: a caixa/tabela do cabecalho
% original, com quadro "CNEN RMB" + 4 colunas + linha de titulos,
% ficou visualmente pesada). O cabecalho passa a mostrar apenas o
% codigo do documento e a secao/apendice corrente, no mesmo registro
% discreto (fonte pequena, cinza, sem caixa) ja usado no rodape. O
% rodape mantem o aviso de reproducao e passa a numerar as paginas
% "N de M" dentro de cada secao/apendice (nao mais de forma cumulativa
% no capitulo), com secoes e apendices sempre iniciando em pagina nova
% -- ver \nusecbreak mais abaixo.
% ---------------------------------------------------------------------
\RequirePackage{fancyhdr}
\RequirePackage{multirow}
\RequirePackage{atbegshi}
% raggedbottom evita que paginas quase cheias (como o Sumario) sejam
% esticadas ate preencher exatamente \textheight -- esse esticamento
% (padrao de \flushbottom, herdado da classe book/extbook) pode empurrar
% um resto de espaco em branco, sem texto visivel, para uma pagina extra.
\raggedbottom
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\color{nugray}\hrule height \headrulewidth}
\renewcommand{\footrule}{\color{nugray}\hrule height \footrulewidth \vskip -0.4pt}

\newcommand{\docshorttitle}{PROPOSTA -- CAP\'ITULO 1}
\newcommand{\docrevision}{Rev.~0 (Minuta de Trabalho)}
\newcommand{\docdate}{Setembro 2026}
\newcommand{\doccode}{RMB-N00-00-LN-G-7240-RA-001}
\newcommand{\doctitlefull}{Relat\'orio Preliminar de An\'alise de Seguran\c{c}a (RPAS) do Reator RMB}
% Revisao da secao corrente: valor unico simplificado (a minuta nao
% controla revisao independente por secao); ajuste aqui se necessario.
% Mantido igual a "REV. B" usado na capa (foto_capa.tex).
\newcommand{\docsecrev}{B}

% \nuchaptitle / \nusectitle sao preenchidos automaticamente por
% \chaptermark / \sectionmark (chamados internamente pelo LaTeX a cada
% \chapter{...} / \section{...}) -- nao exigem alterar cap1.tex.
\newcommand{\nuchaptitle}{}
\newcommand{\nusectitle}{}
\renewcommand{\chaptermark}[1]{\gdef\nuchaptitle{#1}\markboth{\MakeUppercase{CAP\'ITULO \thechapter\ -- #1}}{}}
\renewcommand{\sectionmark}[1]{\gdef\nusectitle{#1}}

% ---------------------------------------------------------------------
% \nusecbreak{id}{rotulo}: marca o inicio de uma nova secao/apendice/
% anexo. Sempre comeca em pagina nova, reinicia a contagem de paginas
% "N de M" a partir dela, e atualiza o rotulo mostrado no cabecalho.
% "id" e uma chave curta e estavel (ex. "1.1", "A", "anexo1"), usada
% apenas para gravar/ler o total de paginas no .aux (mesma logica de
% \label/\pageref: o total so fica correto apos uma nova compilacao).
% "rotulo" e o texto exibido no cabecalho (ex. "Se\c{c}\~ao 1.1",
% "Ap\^endice A").
% ---------------------------------------------------------------------
\newcounter{secpg}
\newcommand{\nucursecid}{}
\newcommand{\nucurseclabel}{}
\newcommand{\nuwritesectotal}{%
  \ifx\nucursecid\@empty\else
    \immediate\write\@auxout{\string\nusectotal{\nucursecid}{\thesecpg}}%
  \fi
}
\newcommand{\nusectotal}[2]{\expandafter\gdef\csname nusectot@#1\endcsname{#2}}
\newcommand{\nugetsectotal}[1]{%
  \expandafter\ifx\csname nusectot@#1\endcsname\relax ?%
  \else\csname nusectot@#1\endcsname\fi
}
\newcommand{\nusecbreak}[2]{%
  \nuwritesectotal
  \clearpage
  \setcounter{secpg}{1}%
  \gdef\nucursecid{#1}%
  \gdef\nucurseclabel{#2}%
}
% \nusecbreaknopage{id}{rotulo}: mesma contabilidade do \nusecbreak, mas
% sem forcar um \clearpage proprio -- para usar logo apos um comando que
% ja quebra a pagina por conta propria (ex. \tableofcontents, via
% \chapter*), evitando dois \clearpage consecutivos.
\newcommand{\nusecbreaknopage}[2]{%
  \nuwritesectotal
  \setcounter{secpg}{1}%
  \gdef\nucursecid{#1}%
  \gdef\nucurseclabel{#2}%
}
\AtEndDocument{\nuwritesectotal}
\AtBeginShipout{\stepcounter{secpg}}

% \apref{destino}{X}: referencia cruzada para "Apendice X", clicavel ate
% o \hypertarget{destino}{} colocado no \section*{...} do apendice em
% questao. Os apendices usam \section* (nao numerado, mantendo o padrao
% do documento) -- e por isso NAO usamos aqui \label + \hyperref[label]:
% \section* nao chama \refstepcounter, entao hyperref nao cria uma ancora
% propria naquele ponto, e um \label logo depois acaba "herdando" a
% ancora do ultimo elemento numerado anterior (ex. a ultima tabela da
% secao anterior) -- o link resultante levaria para o lugar errado
% (confirmado: apontava para uma tabela da Se\c{c}\~ao 1.8, nao para o
% inicio do Ap\^endice). \hypertarget/\hyperlink cria e aponta para uma
% ancora independente de contadores, resolvendo isso. O texto "Apendice
% X" e escrito literalmente (n\~ao vem de \ref/contador). hidelinks (ja
% carregado via hyperref no main.tex) mantem o link sem cor/caixa
% visivel, igual ao \citep existente.
\newcommand{\apref}[2]{\hyperlink{#1}{Ap\^endice~#2}}

\newcommand{\nufooterpage}{\thesecpg~de~\nugetsectotal{\nucursecid}}

\newcommand{\nurunninghead}{%
  \footnotesize\sffamily\textcolor{nugray}{\doccode}\hfill\textcolor{nugray}{\nucurseclabel\ -- Rev.~\docsecrev}%
}

% Fonte reduzida (\tiny) para caber em uma unica linha, como no
% documento original -- em \footnotesize ou \scriptsize o aviso e mais
% largo que a propria pagina (medido: ~481pt de 463pt disponiveis) e
% sempre quebra em duas linhas. Mantido dentro de uma minipage (como na
% versao anterior): sem ela, o texto passado diretamente a \fancyfoot
% quebra a expansao de \listoftables/\listoffigures mais adiante no
% documento (erro "Argument of \T1\' has an extra }" -- isolado e
% confirmado em teste minimo).
\newcommand{\nurunningfootnote}{%
  \begin{minipage}[t]{0.85\textwidth}
  \tiny\sffamily\textcolor{nugray}\raggedright
  \'E proibida a duplica\c{c}\~ao ou reprodu\c{c}\~ao deste volume ou de parte do mesmo, sob quaisquer meios, sem autoriza\c{c}\~ao expressa da CNEN
  \end{minipage}%
}

\fancyhead[C]{\nurunninghead}
\fancyfoot[L]{\nurunningfootnote}
\fancyfoot[R]{\footnotesize\sffamily\textcolor{nugray}{\nufooterpage}}

\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyhead[C]{\nurunninghead}
  \fancyfoot[L]{\nurunningfootnote}
  \fancyfoot[R]{\footnotesize\sffamily\textcolor{nugray}{\nufooterpage}}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0.4pt}
}

% ---------------------------------------------------------------------
% Titulos de capitulo/secao - sobrios, estilo relatorio tecnico (sem
% os grandes blocos coloridos tipicos de "livro"; mais proximo de
% relatorio corporativo/regulatorio)
% ---------------------------------------------------------------------
\RequirePackage{titlesec}

% O titulo que \chapter{...} imprimiria normalmente e descartado aqui
% (capturado num box que nunca e exibido): mantemos \chapter{} "por
% baixo dos panos" -- ele ainda incrementa o contador do capitulo (do
% qual depende a numeracao de pagina 1-1, 1-2... via chappg), gera a
% entrada no Sumario, o marcador de rodape (\chaptermark) e o marcador
% de PDF (hyperref) -- mas nada disso exige que o titulo seja
% desenhado na pagina. Quem desenha o titulo visivel e \chapterbanner,
% chamado manualmente logo em seguida no conteudo.
\titleformat{\chapter}[block]
  {\normalfont}{}{0pt}
  {\setbox\z@\hbox\bgroup}
  [\egroup]
\titlespacing*{\chapter}{0pt}{0pt}{0pt}

\newcommand{\chapterbanner}[2]{%
  % #1 = numero do capitulo (ex. 1)  #2 = titulo do capitulo
  \begingroup
  \setlength{\parindent}{0pt}
  \color{nurule}\rule{\textwidth}{1.4pt}\\[2pt]
  {\sffamily\Large\bfseries CAP\'ITULO #1}\\[8pt]
  {\sffamily\huge\bfseries #2}\\[2pt]
  \color{nurule}\rule{\textwidth}{0.6pt}
  \endgroup
  \vspace{10pt}
}

\titleformat{\section}
  {\normalfont\sffamily\large\bfseries\color{nurule}}
  {\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{18pt}{8pt}

\titleformat{\subsection}
  {\normalfont\sffamily\bfseries\color{nurule}}
  {\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

\RequirePackage{mdframed}

